{
  "name": "@datenflix/ts-text-marker-viewer",
  "version": "0.1.0",
  "description": "Framework-unabhängiger PDF/TXT Viewer mit Such- und Annotation-Highlights.",
  "type": "module",
  "main": "./dist/ts-text-marker-viewer.js",
  "module": "./dist/ts-text-marker-viewer.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/ts-text-marker-viewer.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -p tsconfig.build.json && vite build",
    "preview": "vite preview",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "screenshots": "playwright test tests/screenshots.spec.ts --project=edge"
  },
  "dependencies": {
    "pdfjs-dist": "^6.3.289"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.3.0",
    "jsdom": "^27.0.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
}
